# Cargo build output
/target/

# Generated by build.rs from assets/logo.png (Windows icon; macOS .icns is
# committed so Windows packaging can reference it without a macOS host).
/assets/marina.ico

# Release output
/dist/
# Generated per-release Release body (extracted from CHANGELOG.md by xtask manifest)
/release-body.md

# Legacy local key material; releases no longer sign, keep any such file out of the repo.
*.sk
marina-update-key*

# Local development scratch: plans, notes, temp/backup files. Never publish these.
/plans/
/notes/
/scratch/
*.local.md
*.local.toml
*.tmp
*.temp
*.bak
*.orig
*.rej
*.log

# Editor / IDE / OS noise.
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Local environment / credential material (beyond the key patterns above).
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
